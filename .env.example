# App Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend & Security
SECRET_KEY=supersecretjwtsecretkeymustbechangedinproduction1234567890
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Database (PostgreSQL default; fallback to SQLite if SQLALCHEMY_DATABASE_URI uses sqlite)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=resume_analyser_db
# Set DATABASE_URL to override (e.g. sqlite+aiosqlite:///./dev.db)
DATABASE_URL=sqlite+aiosqlite:///./app.db

# Anthropic Claude API
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# External Job APIs (Optional adapters)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
RAPIDAPI_KEY=

# Frontend
VITE_API_URL=http://localhost:8000/api/v1
